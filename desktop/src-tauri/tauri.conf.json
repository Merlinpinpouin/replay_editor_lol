{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lolclip",
  "version": "0.2.1",
  "identifier": "com.merlinpinpouin.lolclip",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Merlinpinpouin",
    "shortDescription": "Éditeur de replays League of Legends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
